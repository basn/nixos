+
+    # Cron output is the only Hermes state exposed to terminal sandboxes. Resolve
+    # the source from this turn's profile home so multiplexed profiles cannot see
+    # one another's jobs, reports, credentials, or session databases.
+    if scope.get("TERMINAL_ENV") == "docker":
+        output_dir = (home / "cron" / "output").resolve()
+        if output_dir.is_dir():
+            try:
+                volumes = json.loads(scope.get("TERMINAL_DOCKER_VOLUMES", "[]"))
+            except (TypeError, ValueError, json.JSONDecodeError):
+                # Preserve the terminal backend's existing actionable error for
+                # malformed user configuration.
+                volumes = None
+            if isinstance(volumes, list):
+                destination_in_use = any(
+                    isinstance(volume, str)
+                    and (":/cron-output:" in volume or volume.endswith(":/cron-output"))
+                    for volume in volumes
+                )
+                if not destination_in_use:
+                    volumes.append(f"{output_dir}:/cron-output:ro")
+                    scope["TERMINAL_DOCKER_VOLUMES"] = json.dumps(volumes)
     return scope
 
 
