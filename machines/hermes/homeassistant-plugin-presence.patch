+++ b/tests/hermes_cli/test_left_core_migration.py
@@ -35,0 +36,7 @@ def _home(tmp_path: Path, name: str = "home", *, env: str = "", config: str = "") -> Path:
+def _directory_plugin(path: Path, *, name: str = "homeassistant", manifest: str | None = None) -> Path:
+    path.mkdir(parents=True)
+    (path / "plugin.yaml").write_text(
+        manifest if manifest is not None else f"name: {name}\nversion: 1.0.0\n", encoding="utf-8")
+    return path
+
+
@@ -116 +123 @@ def test_migrate_home_installs_the_catalog_plugin_once(tmp_path):
-        (home / "plugins" / name).mkdir(parents=True)
+        _directory_plugin(home / "plugins" / name)
@@ -158,0 +166,21 @@ def test_home_without_homeassistant_gets_nothing_and_no_notice(tmp_path):
+@pytest.mark.parametrize("directory", ["homeassistant", "nix-managed-homeassistant"])
+def test_plugin_present_uses_manifest_identity_not_directory_name(tmp_path, directory):
+    home = _home(tmp_path)
+    source = _directory_plugin(tmp_path / "plugin-source")
+    plugins = home / "plugins"
+    plugins.mkdir()
+    (plugins / directory).symlink_to(source, target_is_directory=True)
+
+    assert lcm.plugin_present("homeassistant", home) is True
+
+
+def test_plugin_present_ignores_directory_name_without_matching_manifest(tmp_path):
+    home = _home(tmp_path)
+    plugins = home / "plugins"
+    _directory_plugin(plugins / "homeassistant", name="different-plugin")
+    (plugins / "missing-manifest").mkdir()
+    _directory_plugin(plugins / "malformed", manifest="- not-a-mapping\n")
+
+    assert lcm.plugin_present("homeassistant", home) is False
+
+
