diff --git a/hermes_cli/left_core_migration.py b/hermes_cli/left_core_migration.py
index 9525fc7d74..cc719cf14f 100644
--- a/hermes_cli/left_core_migration.py
+++ b/hermes_cli/left_core_migration.py
@@ -424,2 +424,7 @@ def plugin_present(plugin: str, home: Path) -> bool:
-    """Installed in *home* (enabled or not: a user who disabled it chose to). Read-only."""
-    return (home / "plugins" / plugin).is_dir()
+    """Installed in *home* under its discovery identity (enabled or not: a user who disabled it chose to).
+    Read-only. Directory names are not identities: declarative Nix installs deliberately use a
+    ``nix-managed-`` prefix, while discovery enables them by manifest key/name."""
+    from hermes_cli.plugins_discovery import scan_directory
+    from hermes_cli.plugins_manifest import manifest_key
+    return any(plugin in {manifest_key(manifest), manifest.name}
+               for manifest in scan_directory(home / "plugins", "user"))
diff --git a/tests/hermes_cli/test_left_core_migration.py b/tests/hermes_cli/test_left_core_migration.py
index c5a83cc0e8..579dd7c871 100644
