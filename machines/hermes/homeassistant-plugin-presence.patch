+    _directory_plugin(home / "plugins" / "homeassistant")
@@ -139,0 +169,16 @@ def test_a_disabled_or_present_plugin_is_left_alone(tmp_path):
+def test_nix_managed_plugin_records_install_with_lazy_installs_off(tmp_path, monkeypatch):
+    home = _home(tmp_path, env="HASS_TOKEN=abc\n", config="toolsets: [homeassistant]\n")
+    source = _directory_plugin(tmp_path / "plugin-source")
+    (home / "plugins").mkdir()
+    (home / "plugins" / "nix-managed-homeassistant").symlink_to(source, target_is_directory=True)
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    import pm.install
+    monkeypatch.setattr(pm.install, "lazy_installs_allowed", lambda: False)
+    monkeypatch.setattr(lcm, "_install_into", lambda h: pytest.fail("installed"))
+    said = []
+
+    assert lcm.recover_at_startup(say=said.append) == []
+    assert said == []
+    assert lcm._read_config(home)["_left_core_installed"] == ["homeassistant"]
+
+
