+def final_log_snapshot_command(quoted_log_path: str, offset: int) -> str:
+    """Read and encode one exact final byte window, or emit no success record."""
+    return (
+        f"O={offset}; "
+        'D=$(mktemp) || exit 90; E=$(mktemp) || { rm -f "$D"; exit 90; }; '
+        "trap 'rm -f \"$D\" \"$E\"' 0 1 2 15; "
+        f"S=$(wc -c < {quoted_log_path}) || exit 91; "
+        "case \"$S\" in ''|*[!0-9]*) exit 91;; esac; "
+        'if [ "$S" -lt "$O" ]; then O=0; fi; N=$((S-O)); '
+        f'dd if={quoted_log_path} bs=1 skip="$O" count="$N" of="$D" 2>/dev/null || exit 92; '
+        'R=$(wc -c < "$D") || exit 92; [ "$R" -eq "$N" ] || exit 92; '
+        'base64 -w 0 "$D" > "$E" || exit 93; '
+        'B=$(wc -c < "$E") || exit 93; X=$(((N+2)/3*4)); '
+        '[ "$B" -eq "$X" ] || exit 93; '
+        f"printf '{FINAL_LOG_SNAPSHOT_PREFIX} %s %s %s\\n' \"$S\" \"$O\" \"$N\"; "
+        'cat "$E" || exit 94'
+    )
