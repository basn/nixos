diff --git a/tests/tools/test_process_registry_final_drain.py b/tests/tools/test_process_registry_final_drain.py
new file mode 100644
--- /dev/null
+++ b/tests/tools/test_process_registry_final_drain.py
@@ -0,0 +1,191 @@
+"""Regression tests for trustworthy final sandbox log snapshots."""
+
+import base64
+import os
+import subprocess
+import sys
+import time
+from unittest.mock import patch
+
+import pytest
+
+from tools.process_registry import ProcessRegistry, ProcessSession
+from tools.process_registry_env_log import FINAL_LOG_SNAPSHOT_PREFIX
+
+
+def _snapshot(size, offset, payload):
+    encoded = base64.b64encode(payload).decode("ascii")
+    return f"{FINAL_LOG_SNAPSHOT_PREFIX} {size} {offset} {len(payload)}\n{encoded}"
+
+
+def _run_case(tmp_path, exit_code, mode, *, initial=b"HEALTH_EXIT=0\n", final=b"FINAL\n"):
+    log, pid, status = (tmp_path / name for name in ("bg.log", "bg.pid", "bg.exit"))
+    payload = tmp_path / "final.bin"
+    log.write_bytes(initial)
+    payload.write_bytes(final)
+    with log.open("ab") as out:
+        child = subprocess.Popen(
+            [
+                sys.executable,
+                "-c",
+                "import os,sys; os.read(0,1); os.write(1,open(sys.argv[1],'rb').read()); sys.exit(int(sys.argv[2]))",
+                str(payload),
+                str(exit_code),
+            ],
+            stdin=subprocess.PIPE,
+            stdout=out,
+        )
+    pid.write_text(str(child.pid))
+
+    registry = ProcessRegistry()
+    events = []
+    registry.on_output = lambda _session, chunk: events.append(("output", chunk))
+    session = ProcessSession(
+        id="proc_final_drain",
+        command="local fixture",
+        task_id="test",
+        started_at=time.time(),
+        notify_on_complete=True,
+        watch_patterns=["FINAL"],
+    )
+    registry._running[session.id] = session
+
+    class Env:
+        first = True
+
+        def execute(self, command, **_kwargs):
+            if command.startswith("O=") and not self.first:
+                if mode == "missing":
+                    log.unlink()
+                elif mode == "unreadable":
+                    log.unlink()
+                    log.mkdir()
+                elif mode == "short":
+                    return {"output": _snapshot(10, 0, b"short")}
+                elif mode == "missing_payload":
+                    return {"output": f"{FINAL_LOG_SNAPSHOT_PREFIX} 5 0 5\n"}
+                elif mode == "error_payload":
+                    return {"output": f"{FINAL_LOG_SNAPSHOT_PREFIX} 3 0 3\n!!!!"}
+                elif mode == "forward_offset":
+                    return {"output": _snapshot(20, 20, b"")}
+                elif mode == "backward_nonzero":
+                    return {"output": _snapshot(5, 2, b"xxx")}
+                elif mode == "unjustified_zero":
+                    return {"output": _snapshot(20, 0, b"x" * 20)}
+                elif mode == "backend_error":
+                    raise RuntimeError("injected transport failure")
+                elif mode == "truncated":
+                    log.write_bytes(final)
+                elif mode == "killed_before":
+                    registry._finish_exited(session, -15, reason="killed", source="test")
+                result = subprocess.run(
+                    ["bash", "-c", command], capture_output=True, text=True, timeout=10,
+                )
+                if mode == "killed_after":
+                    registry._finish_exited(session, -15, reason="killed", source="test")
+                return {"output": result.stdout, "returncode": result.returncode}
+            result = subprocess.run(
+                ["bash", "-c", command], capture_output=True, text=True, timeout=10,
+            )
+            if command.startswith("O=") and self.first:
+                self.first = False
+                child.communicate(b"!", timeout=10)
+                status.write_text(str(child.returncode) + "\n")
+            return {"output": result.stdout, "returncode": result.returncode}
+
+    try:
+        with (
+            patch("tools.process_registry.time.sleep"),
+            patch("tools.process_registry.save_completed_result"),
+            patch.object(registry, "_write_checkpoint"),
+            patch.object(registry, "_release_finished_handles"),
+        ):
+            registry._env_poller_loop(session, Env(), str(log), str(pid), str(status))
+    finally:
+        if log.exists():
+            os.chmod(log, 0o600)
+        if child.poll() is None:
+            child.kill()
+            child.wait()
+    notifications = []
+    while not registry.completion_queue.empty():
+        notifications.append(registry.completion_queue.get_nowait())
+    return session, events, notifications
+
+
+@pytest.mark.parametrize("exit_code", [0, 17, 75])
+def test_final_output_is_published_before_one_real_completion(tmp_path, exit_code):
+    session, events, notifications = _run_case(tmp_path, exit_code, "ok")
+    assert session.exit_code == exit_code
+    assert session.completion_reason == "exited"
+    assert session.output_buffer == "HEALTH_EXIT=0\nFINAL\n"
+    assert events == [("output", "HEALTH_EXIT=0\n"), ("output", "FINAL\n")]
+    assert [event["type"] for event in notifications] == ["watch_match", "completion"]
+    assert notifications[-1]["output"] == session.output_buffer
+
+
+def test_final_output_keeps_buffer_and_completion_limits(tmp_path):
+    session, _events, notifications = _run_case(
+        tmp_path, 0, "ok", initial=b"", final=b"x" * 200_005,
+    )
+    assert session.output_buffer == "x" * 200_000
+    assert [event["type"] for event in notifications] == ["completion"]
+    assert notifications[0]["output"] == "x" * 2000
+    assert notifications[0]["output_cut"] == 198_000
+
+
+@pytest.mark.parametrize(
+    "mode",
+    [
+        "missing",
+        "unreadable",
+        "short",
+        "missing_payload",
+        "error_payload",
+        "forward_offset",
+        "backward_nonzero",
+        "unjustified_zero",
+        "backend_error",
+    ],
+)
+def test_failed_final_snapshot_keeps_verified_output_and_reports_lost(tmp_path, mode):
+    session, events, notifications = _run_case(tmp_path, 17, mode)
+    assert session.exit_code == -1
+    assert session.completion_reason == "lost"
+    assert session.output_buffer == "HEALTH_EXIT=0\n"
+    assert events == [("output", "HEALTH_EXIT=0\n")]
+    assert [event["type"] for event in notifications] == ["completion"]
+    assert notifications[0]["output"] == "HEALTH_EXIT=0\n"
+
+
+@pytest.mark.parametrize(
+    ("mode", "initial", "final", "expected"),
+    [
+        ("ok", b"", b"", ""),
+        ("truncated", b"stale output", b"fresh", "fresh"),
+        ("ok", b"prefix \xf0\x9f", b"\x98\x80", "prefix 😀"),
+        ("ok", b"prefix ", b"\xf0\x9f", "prefix \ufffd"),
+        ("ok", b"prefix ", b"\xfftail", "prefix \ufffdtail"),
+    ],
+)
+def test_final_snapshot_preserves_empty_truncated_and_byte_edge_cases(
+    tmp_path, mode, initial, final, expected,
+):
+    session, _events, notifications = _run_case(
+        tmp_path, 0, mode, initial=initial, final=final,
+    )
+    assert session.exit_code == 0
+    assert session.output_buffer == expected
+    assert [event["type"] for event in notifications] == ["completion"]
+    assert notifications[0]["output"] == expected
+
+
+@pytest.mark.parametrize("mode", ["killed_before", "killed_after"])
+def test_concurrent_kill_wins_without_post_completion_mutation(tmp_path, mode):
+    session, events, notifications = _run_case(tmp_path, 75, mode)
+    assert session.exit_code == -15
+    assert session.completion_reason == "killed"
+    assert session.output_buffer == "HEALTH_EXIT=0\n"
+    assert events == [("output", "HEALTH_EXIT=0\n")]
+    assert [event["type"] for event in notifications] == ["completion"]
+    assert notifications[0]["output"] == "HEALTH_EXIT=0\n"
