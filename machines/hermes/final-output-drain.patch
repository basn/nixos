diff --git a/tests/tools/test_process_registry_final_drain.py b/tests/tools/test_process_registry_final_drain.py
new file mode 100644
index 00000000..d8ab558e
--- /dev/null
+++ b/tests/tools/test_process_registry_final_drain.py
@@ -0,0 +1,61 @@
+"""A real subprocess finishes between a sandbox log snapshot and exit check."""
+import subprocess
+import sys
+import time
+from unittest.mock import patch
+
+import pytest
+from tools.process_registry import ProcessRegistry, ProcessSession
+
+
+@pytest.mark.parametrize("exit_code", [0, 17, 75])
+@pytest.mark.parametrize("final_read", ["ok", "bad_header", "backend_error", "killed"])
+def test_final_output_is_drained_before_completion(tmp_path, exit_code, final_read):
+    log, pid, status = (tmp_path / name for name in ("bg.log", "bg.pid", "bg.exit"))
+    initial = "HEALTH_EXIT=0\n"
+    final = "CANDIDATE_AUDIT_JSON_BEGIN\n" + ("x" * 40000) + "\nCANDIDATE_AUDIT_JSON_END\nAUDIT_EXIT=" + str(exit_code) + "\n"
+    log.write_text(initial)
+    with log.open("a") as out:
+        child = subprocess.Popen(
+            [sys.executable, "-c", "import sys; sys.stdin.read(1); sys.stdout.write(sys.argv[1]); sys.exit(int(sys.argv[2]))", final, str(exit_code)],
+            stdin=subprocess.PIPE, stdout=out,
+        )
+    pid.write_text(str(child.pid))
+
+    class Env:
+        first = True
+        def execute(self, command, **kwargs):
+            if command.startswith("O=") and not self.first:
+                if final_read == "bad_header":
+                    return {"output": "", "returncode": 1}
+                if final_read == "backend_error":
+                    raise RuntimeError("injected transport failure")
+                if final_read == "killed":
+                    registry._finish_exited(session, -15, reason="killed", source="test")
+            result = subprocess.run(["bash", "-c", command], capture_output=True, text=True, timeout=10)
+            if command.startswith("O=") and self.first:
+                self.first = False
+                # Finish AFTER the log read, BEFORE the poller's kill -0.
+                child.communicate(b"!", timeout=10)
+                status.write_text(str(child.returncode) + "\n")
+            return {"output": result.stdout, "returncode": result.returncode}
+
+    registry = ProcessRegistry()
+    session = ProcessSession(id="proc_final_drain", command="local fixture", task_id="test", started_at=time.time())
+    published = []
+    try:
+        with patch("tools.process_registry.time.sleep"), patch.object(registry, "_move_to_finished", side_effect=lambda s: published.append(s.output_buffer)):
+            registry._env_poller_loop(session, Env(), str(log), str(pid), str(status))
+        if final_read == "ok":
+            assert session.exit_code == exit_code
+            assert session.output_buffer == initial + final
+            assert published == [initial + final]
+        else:
+            assert session.exit_code == (-15 if final_read == "killed" else -1)
+            assert session.completion_reason == ("killed" if final_read == "killed" else "lost")
+            assert session.output_buffer == initial
+            assert published == [initial]
+    finally:
+        if child.poll() is None:
+            child.kill()
+            child.wait()
