{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.6-terra",
  "default_agent": "build",
  "subagent_depth": 1,
  "provider": {
    "ollama": {
      "name": "Ollama (local)",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1"
      },
      "models": {
        "qwen3:8b": {
          "name": "Qwen3 8B (local)"
        }
      }
    },
    "local": {
      "name": "local",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen3:8b": {
          "name": "Qwen3 8B (local worker)"
        }
      }
    },
    "openai": {
      "models": {
        "gpt-5.6-terra": {
          "options": {
            "reasoningEffort": "low",
            "textVerbosity": "low"
          }
        },
        "gpt-5.6-luna": {
          "options": {
            "reasoningEffort": "none",
            "textVerbosity": "low"
          }
        }
      }
    }
  },
  "agent": {
    "plan": {
      "model": "openai/gpt-5.6-terra",
      "reasoningEffort": "medium",
      "textVerbosity": "low"
    },
    "build": {
      "model": "openai/gpt-5.6-terra",
      "reasoningEffort": "low",
      "textVerbosity": "low"
    },
    "astra-orchestrator": {
      "description": "Plans and coordinates repository work, delegating implementation and testing to the Sol coder.",
      "mode": "primary",
      "model": "openai/gpt-6-astra",
      "prompt": "You are the orchestration and planning agent. Analyze requests and relevant repository context, produce the plan, and coordinate the work. Delegate all implementation and testing to sol-coder. Review the coder result before reporting back. Do not edit files, run shell commands, implement changes, or perform tests yourself.",
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "edit": "deny",
        "bash": "deny",
        "task": {
          "*": "deny",
          "sol-coder": "allow"
        }
      }
    },
    "sol-coder": {
      "description": "Implements changes and runs tests under direction from the Astra orchestrator; cannot delegate further.",
      "mode": "subagent",
      "model": "openai/gpt-5.6-sol",
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "edit": "allow",
        "bash": "allow",
        "task": "deny"
      }
    }
  },
  "mcp": {
    "homeassistant": {
      "type": "local",
      "enabled": true,
      "command": [
        "nix",
        "shell",
        "nixpkgs#uv",
        "nixpkgs#python312",
        "-c",
        "uv",
        "tool",
        "run",
        "--python",
        "python3.12",
        "mcp-server-home-assistant"
      ],
      "environment": {
        "HOME_ASSISTANT_WEB_SOCKET_URL": "{env:HOME_ASSISTANT_WEB_SOCKET_URL}",
        "HOME_ASSISTANT_API_TOKEN": "{env:HOME_ASSISTANT_API_TOKEN}"
      },
      "timeout": 60000
    },
    "nixos": {
      "type": "local",
      "enabled": true,
      "command": [
        "nix",
        "run",
        "nixpkgs#mcp-nixos",
        "--"
      ]
    }
  },
  "lsp": {
    "nixd": {
      "command": [
        "nixd"
      ]
    }
  },
  "small_model": "openai/gpt-5.6-luna"
}
