{
  "$schema": "https://opencode.ai/config.json",
  "plugins": ["@dietrichgebert/ponytail"],
  "model": "openai/gpt-6.1-terra",
  "default_agent": "astra-orchestrator",
  "subagent_depth": 1,
  "permission": {
    "external_directory": {
      "/nix/store/**": "allow"
    }
  },
  "provider": {
    "openai": {
      "models": {
        "gpt-6.1-terra": {
          "options": {
            "reasoningEffort": "low",
            "textVerbosity": "low"
          }
        },
        "gpt-6-luna": {
          "options": {
            "reasoningEffort": "none",
            "textVerbosity": "low"
          }
        }
      }
    }
  },
  "providers": {
    "hermes": {
      "name": "Remote Hermes",
      "env": ["HERMES_API_KEY"],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://api.hermes.basn.se/v1"
      },
      "models": {
        "hermes-agent": {
          "name": "Hermes default agent",
          "capabilities": {
            "tools": false,
            "input": ["text"],
            "output": ["text"]
          }
        }
      }
    }
  },
  "agents": {
    "hermes": {
      "description": "Delegates explicitly requested work to the existing remote Hermes default agent, not the local workspace.",
      "mode": "subagent",
      "model": "hermes/hermes-agent",
      "system": "You are the remote Hermes default agent, not an agent in the caller's local workspace. Work only on the explicitly delegated remote task. Your remote workspace and available files differ from the caller's; local uncommitted edits are invisible unless explicitly supplied. Preserve all existing Hermes approval and security policies; never bypass approval or infer deployment authority. Explain any missing context or blocked approval rather than assuming access or success.",
      "permissions": [
        { "action": "*", "resource": "*", "effect": "deny" }
      ]
    }
  },
  "agent": {
    "plan": {
      "model": "openai/gpt-6.1-terra",
      "reasoningEffort": "medium",
      "textVerbosity": "low"
    },
    "build": {
      "model": "openai/gpt-6.1-terra",
      "reasoningEffort": "low",
      "textVerbosity": "low"
    },
    "astra-orchestrator": {
      "description": "Coordinates repository changes: defines scope and acceptance criteria, and delegates implementation and repository research.",
      "mode": "primary",
      "model": "openai/gpt-6-astra",
      "prompt": "You are the orchestration and planning agent. Define the requested scope, affected files or hosts, and observable acceptance criteria before delegating. Delegate implementation and execution of applicable documented checks to sol-coder, and repository research to explore. Delegate to hermes only when the user explicitly requests remote Hermes work; it operates in its remote workspace and cannot see local dirty edits unless explicitly supplied. Preserve its existing approvals and security policies. Do not implement changes or run shell commands.",
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "external_directory": {
          "/nix/store/**": "allow"
        },
        "edit": "deny",
        "bash": "deny",
        "homeassistant_*": "deny",
        "unifi_*": "deny",
        "drawio_*": "deny",
        "task": {
          "*": "deny",
          "sol-coder": "allow",
          "hermes": "allow",
          "explore": "allow"
        }
      }
    },
    "sol-coder": {
      "description": "Implements changes and runs tests under direction from the Astra orchestrator; cannot delegate further.",
      "mode": "subagent",
      "model": "openai/gpt-6.1-sol",
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "external_directory": {
          "/nix/store/**": "allow"
        },
        "edit": "allow",
        "bash": "allow",
        "task": "deny",
        "homeassistant_*": "deny",
        "unifi_*": "deny",
        "drawio_*": "deny"
      }
    },
    "explore": {
      "description": "Read-only repository exploration for focused research and file discovery.",
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "task": "deny",
        "homeassistant_*": "deny",
        "unifi_*": "deny",
        "drawio_*": "deny"
      }
    }
  },
  "mcp": {
    "homeassistant": {
      "type": "local",
      "enabled": true,
      "command": [
        "nix",
        "run",
        "--inputs-from",
        "/home/basn/nixos",
        "nixpkgs-unstable-small#ha-mcp",
        "--"
      ],
      "environment": {
        "HOMEASSISTANT_URL": "{env:HOMEASSISTANT_URL}",
        "HOMEASSISTANT_TOKEN": "{env:HOMEASSISTANT_TOKEN}"
      },
      "timeout": 60000
    },
    "unifi": {
      "type": "local",
      "enabled": true,
      "command": [
        "nix",
        "shell",
        "--inputs-from",
        "/home/basn/nixos",
        "nixpkgs#nodejs",
        "-c",
        "npx",
        "-y",
        "@robinbowes/unifi-mcp@0.2.6"
      ],
      "environment": {
        "UNIFI_BASE_URL": "https://unifi.local",
        "UNIFI_API_KEY": "{env:UNIFI_API_KEY}",
        "NODE_EXTRA_CA_CERTS": "/home/basn/.config/opencode/unifi-controller.pem",
        "UNIFI_SPEC_URL": "file:///proxy/network/api-docs/integration.json"
      },
      "timeout": 120000
    },
    "nixos": {
      "type": "local",
      "enabled": true,
      "command": [
        "nix",
        "run",
        "--inputs-from",
        "/home/basn/nixos",
        "nixpkgs-unstable-small#mcp-nixos",
        "--"
      ]
    },
    "drawio": {
      "type": "local",
      "enabled": true,
      "command": [
        "nix",
        "shell",
        "--inputs-from",
        "/home/basn/nixos",
        "nixpkgs#nodejs",
        "-c",
        "npx",
        "-y",
        "@drawio/mcp"
      ],
      "timeout": 60000
    }
  },
  "lsp": {
    "nixd": {
      "command": [
        "nixd"
      ]
    }
  },
  "small_model": "openai/gpt-6-luna"
}
