{
  "$schema": "https://opencode.ai/theme.json",
  "base": {
    "categorical": ["blue", "purple", "green", "orange", "red", "cyan", "yellow"],
    "text": {
      "base": "$hue.neutral.200",
      "muted": "$hue.neutral.400",
      "faint": "$hue.neutral.400",
      "action": {
        "primary": {
          "base": "$text.base",
          "$disabled": "$text.muted",
          "$focused": "$background.base",
          "$selected": "$hue.interactive.200"
        },
        "secondary": {"base": "$text.muted", "$hovered": "$text.base"},
        "destructive": {"base": "$background.base", "$disabled": "$text.muted"}
      },
      "formfield": {
        "base": "$text.base",
        "$hovered": "$hue.interactive.200",
        "$focused": "$hue.interactive.200",
        "$pressed": "$hue.interactive.200",
        "$disabled": "$text.muted",
        "$selected": "$hue.interactive.200"
      },
      "feedback": {
        "error": {"base": "$hue.red.200"},
        "warning": {"base": "$hue.yellow.200"},
        "success": {"base": "$hue.green.200"},
        "info": {"base": "$hue.blue.200"}
      }
    },
    "background": {
      "base": "$hue.neutral.900",
      "raised": {
        "base": "$hue.neutral.800",
        "high": "$hue.neutral.700",
        "max": "$hue.neutral.600"
      },
      "action": {
        "primary": {
          "base": "transparent",
          "$hovered": "$background.raised.base",
          "$focused": "$hue.interactive.200",
          "$selected": "transparent"
        },
        "secondary": {"base": "transparent"},
        "destructive": {"base": "$hue.red.200"}
      },
      "formfield": {"base": "$background.base"},
      "feedback": {
        "error": {"base": "$background.base"},
        "warning": {"base": "$background.base"},
        "success": {"base": "$background.base"},
        "info": {"base": "$background.base"}
      }
    },
    "border": {"base": "$hue.neutral.500"},
    "scrollbar": {"base": "$hue.neutral.500"},
    "diff": {
      "text": {
        "added": "$hue.green.200",
        "removed": "$hue.red.200",
        "context": "$text.base",
        "hunkHeader": "$hue.blue.200"
      },
      "background": {
        "added": "$hue.green.900",
        "removed": "$hue.red.900",
        "context": "$background.base"
      },
      "highlight": {"added": "$hue.green.800", "removed": "$hue.red.800"},
      "lineNumber": {
        "text": "$hue.neutral.500",
        "background": {"added": "$hue.green.900", "removed": "$hue.red.900"}
      }
    },
    "syntax": {
      "comment": "$hue.neutral.400",
      "keyword": "$hue.purple.200",
      "function": "$hue.blue.200",
      "variable": "$hue.red.200",
      "string": "$hue.green.200",
      "number": "$hue.orange.200",
      "type": "$hue.yellow.200",
      "operator": "$hue.cyan.200",
      "punctuation": "$hue.neutral.200"
    },
    "markdown": {
      "text": "$hue.neutral.200",
      "heading": "$hue.blue.200",
      "link": "$hue.blue.200",
      "linkText": "$hue.cyan.200",
      "code": "$hue.green.200",
      "blockQuote": "$hue.neutral.400",
      "emphasis": "$hue.yellow.200",
      "strong": "$hue.orange.200",
      "horizontalRule": "$hue.neutral.500",
      "listItem": "$hue.red.200",
      "listEnumeration": "$hue.orange.200",
      "image": "$hue.purple.200",
      "imageText": "$hue.cyan.200",
      "codeBlock": "$hue.neutral.200"
    },
    "@dialog": {
      "background": {
        "base": "$background.raised.base",
        "action": {"primary": {"$hovered": "$background.raised.high"}}
      }
    }
  },
  "dark": {
    "hue": {
      "gray": {
        "100": "#c8ccd4", "200": "#abb2bf", "300": "#979daa",
        "400": "#7f848e", "500": "#495162", "600": "#262a30",
        "700": "#1c1f24", "800": "#121417", "900": "#000000"
      },
      "red": {
        "100": "#ff8a9a", "200": "#ef596f", "300": "#d34e62",
        "400": "#b34254", "500": "#913644", "600": "#702a34",
        "700": "#50202a", "800": "#3c161c", "900": "#1d0b0d"
      },
      "orange": {
        "100": "#eab88a", "200": "#d19a66", "300": "#b88759",
        "400": "#9d734c", "500": "#805e3e", "600": "#644930",
        "700": "#493623", "800": "#302317", "900": "#19120c"
      },
      "yellow": {
        "100": "#f4d8a0", "200": "#e5c07b", "300": "#c9a86c",
        "400": "#ab8f5c", "500": "#8c754b", "600": "#6d5b3a",
        "700": "#50432b", "800": "#352d1d", "900": "#1b170f"
      },
      "green": {
        "100": "#aae19b", "200": "#89ca78", "300": "#78b169",
        "400": "#669659", "500": "#537b49", "600": "#416039",
        "700": "#30462a", "800": "#22331e", "900": "#10180e"
      },
      "cyan": {
        "100": "#67d5dd", "200": "#2bbac5", "300": "#26a3ad",
        "400": "#208b93", "500": "#1a7278", "600": "#14595e",
        "700": "#0f4145", "800": "#0a2b2e", "900": "#051617"
      },
      "blue": {
        "100": "#8cc9ff", "200": "#61afef", "300": "#5599d1",
        "400": "#4882b2", "500": "#3b6b92", "600": "#2e5372",
        "700": "#223d53", "800": "#172937", "900": "#0c151c"
      },
      "purple": {
        "100": "#eb92f1", "200": "#d55fde", "300": "#bb53c3",
        "400": "#9f47a6", "500": "#823a87", "600": "#662d6a",
        "700": "#4b214e", "800": "#311634", "900": "#190b1a"
      },
      "accent": "$hue.purple",
      "interactive": "$hue.blue",
      "neutral": "$hue.gray"
    }
  }
}
